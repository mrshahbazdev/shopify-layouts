{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Gift Card</title>
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="flex items-center justify-center min-h-screen bg-gray-100">
    <div class="bg-white p-12 rounded-xl shadow-lg text-center max-w-md w-full">
      <h1 class="text-3xl font-serif font-bold mb-4">Gift Card</h1>
      <div class="text-6xl font-bold text-primary mb-8">{{ gift_card.initial_value | money_without_trailing_zeros }}</div>
      <div class="bg-gray-100 p-4 rounded mb-8 font-mono text-xl tracking-widest break-all">
        {{ gift_card.code | format_code }}
      </div>
      <p class="text-gray-500 mb-8">Use this code at checkout to redeem your gift card.</p>
      <a href="{{ shop.url }}" class="bg-primary text-white px-8 py-3 font-bold uppercase tracking-widest hover:bg-accent transition block w-full">Start Shopping</a>
      {% if gift_card.pass_url %}
        <a href="{{ gift_card.pass_url }}" class="mt-4 block">
          <img id="apple-wallet-badge" src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add To Apple Wallet">
        </a>
      {% endif %}
    </div>
  </body>
</html>
