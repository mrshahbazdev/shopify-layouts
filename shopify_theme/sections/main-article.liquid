<article class="container mx-auto px-6 py-20 max-w-4xl" itemscope itemtype="http://schema.org/BlogPosting">
  {% if article.image %}
    <div class="mb-12 rounded-xl overflow-hidden shadow-lg">
      <img src="{{ article.image | image_url: width: 1200 }}" class="w-full h-auto object-cover" alt="{{ article.image.alt }}">
    </div>
  {% endif %}

  <header class="text-center mb-12">
    <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">{{ article.title }}</h1>
    <div class="text-gray-500 text-sm uppercase tracking-widest">
      <span>{{ article.author }}</span> &bull; <span>{{ article.published_at | date: "%B %d, %Y" }}</span>
    </div>
  </header>

  <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
    {{ article.content }}
  </div>

  <div class="mt-12 pt-8 border-t border-gray-100 text-center">
    <a href="{{ blog.url }}" class="text-primary font-bold uppercase tracking-widest text-sm hover:text-accent transition">&larr; Back to {{ blog.title }}</a>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
