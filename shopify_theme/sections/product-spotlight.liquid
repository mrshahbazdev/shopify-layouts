<section class="py-20">
    <div class="container mx-auto px-6">
        <div class="flex flex-col md:flex-row gap-12 items-center">
            <div class="w-full md:w-1/2">
                <div class="relative bg-gray-100 p-8 rounded-2xl">
                    {% if section.settings.product != blank %}
                         {% assign product = all_products[section.settings.product] %}
                         <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title }}" class="w-full mix-blend-multiply">
                    {% else %}
                         <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" alt="Spotlight Product" class="w-full mix-blend-multiply">
                    {% endif %}
                </div>
            </div>
            <div class="w-full md:w-1/2 space-y-6">
                <span class="text-accent font-bold tracking-widest uppercase text-xs">{{ section.settings.eyebrow }}</span>
                <h2 class="text-4xl font-serif font-bold">
                    {% if section.settings.product != blank %}
                        {{ all_products[section.settings.product].title }}
                    {% else %}
                        Premium Wireless Headphones
                    {% endif %}
                </h2>
                <p class="text-gray-600 leading-relaxed">
                     {% if section.settings.product != blank %}
                        {{ all_products[section.settings.product].description | strip_html | truncatewords: 30 }}
                    {% else %}
                        Experience sound like never before with our noise-cancelling technology and 40-hour battery life. Designed for comfort, engineered for performance.
                    {% endif %}
                </p>
                <div class="flex items-center gap-4">
                    <span class="text-3xl font-bold">
                        {% if section.settings.product != blank %}
                            {{ all_products[section.settings.product].price | money }}
                        {% else %}
                            $299
                        {% endif %}
                    </span>
                    <div class="flex text-yellow-400 text-sm">
                        <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
                        <span class="text-gray-400 ml-2">(128 reviews)</span>
                    </div>
                </div>
                <button class="bg-primary text-white px-8 py-4 uppercase font-bold tracking-widest hover:bg-gray-800 transition w-full md:w-auto">Add to Cart</button>
                <div class="pt-6 border-t border-gray-100 grid grid-cols-2 gap-4">
                    <div class="flex items-center gap-2 text-sm text-gray-600"><i class="fas fa-truck text-accent"></i> Free Shipping</div>
                    <div class="flex items-center gap-2 text-sm text-gray-600"><i class="fas fa-shield-alt text-accent"></i> 2 Year Warranty</div>
                </div>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Product Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Product of the Week"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Product Spotlight"
    }
  ]
}
{% endschema %}
