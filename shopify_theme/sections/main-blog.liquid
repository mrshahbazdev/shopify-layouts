<section class="container mx-auto px-6 py-20">
  <h1 class="text-4xl font-serif font-bold text-center mb-16">{{ blog.title }}</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
    {% for article in blog.articles %}
      <article class="group">
        <a href="{{ article.url }}" class="block mb-6 overflow-hidden rounded-lg">
          {% if article.image %}
            <img src="{{ article.image | image_url: width: 600 }}" class="w-full h-64 object-cover group-hover:scale-105 transition duration-500" alt="{{ article.title }}">
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'w-full h-64 object-cover bg-gray-200' }}
          {% endif %}
        </a>
        <div class="text-xs text-accent font-bold uppercase tracking-widest mb-2">{{ article.tags.first }}</div>
        <h2 class="text-2xl font-bold mb-3 group-hover:text-primary transition"><a href="{{ article.url }}">{{ article.title }}</a></h2>
        <p class="text-gray-500 mb-4 line-clamp-3">{{ article.excerpt_or_content | strip_html }}</p>
        <a href="{{ article.url }}" class="text-sm font-bold border-b border-black pb-1 hover:text-accent hover:border-accent transition">Read More</a>
      </article>
    {% endfor %}
  </div>

  {% if paginate.pages > 1 %}
    <div class="mt-12 text-center">
      {{ paginate | default_pagination }}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
