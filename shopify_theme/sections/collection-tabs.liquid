<section class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-serif font-bold mb-4">{{ section.settings.title }}</h2>
      <div class="flex justify-center gap-6 border-b border-gray-200">
        {% for block in section.blocks %}
          <button
            onclick="openTab(event, 'tab-{{ block.id }}')"
            class="tab-btn px-4 py-2 text-sm font-bold uppercase tracking-widest text-gray-500 hover:text-black border-b-2 border-transparent hover:border-black transition {% if forloop.first %}text-black border-black active{% endif %}"
          >
            {{ block.settings.collection.title | default: block.settings.title }}
          </button>
        {% endfor %}
      </div>
    </div>

    {% for block in section.blocks %}
      <div id="tab-{{ block.id }}" class="tab-content {% unless forloop.first %}hidden{% endunless %}">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          {% assign collection = collections[block.settings.collection] %}
          {% for product in collection.products limit: 4 %}
            <a href="{{ product.url }}" class="group block">
              <div class="bg-gray-100 aspect-[3/4] mb-4 overflow-hidden relative">
                <img src="{{ product.featured_image | image_url: width: 600 }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" alt="{{ product.title }}">
              </div>
              <h3 class="font-bold text-sm">{{ product.title }}</h3>
              <p class="text-gray-500 text-sm">{{ product.price | money }}</p>
            </a>
          {% else %}
             {% for i in (1..4) %}
                <div class="group block">
                   <div class="bg-gray-100 aspect-[3/4] mb-4 overflow-hidden relative">
                      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover text-gray-300' }}
                   </div>
                   <h3 class="font-bold text-sm">Product {{ i }}</h3>
                   <p class="text-gray-500 text-sm">$49.00</p>
                </div>
             {% endfor %}
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>

  <script>
    function openTab(evt, tabName) {
      var i, tabcontent, tablinks;
      tabcontent = document.getElementsByClassName("tab-content");
      for (i = 0; i < tabcontent.length; i++) {
        tabcontent[i].classList.add("hidden");
      }
      tablinks = document.getElementsByClassName("tab-btn");
      for (i = 0; i < tablinks.length; i++) {
        tablinks[i].classList.remove("text-black", "border-black");
        tablinks[i].classList.add("text-gray-500", "border-transparent");
      }
      document.getElementById(tabName).classList.remove("hidden");
      evt.currentTarget.classList.add("text-black", "border-black");
      evt.currentTarget.classList.remove("text-gray-500", "border-transparent");
    }
  </script>
</section>

{% schema %}
{
  "name": "Collection Tabs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Curated Collections"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title (Optional)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tabs",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
