<section class="bg-accent py-4 text-white overflow-hidden" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="marquee-container">
        <div class="marquee-content font-bold uppercase tracking-widest text-lg">
            {% for i in (1..10) %}
               {{ section.settings.text }} &nbsp; • &nbsp;
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "New Styles Added"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#3b82f6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}
