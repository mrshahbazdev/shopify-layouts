<section class="py-12">
    <div class="container mx-auto px-6">
        <h2 class="text-3xl font-serif font-bold text-center mb-12">{{ section.settings.title }}</h2>
        <div class="columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6">
            {% for block in section.blocks %}
                <div class="relative group">
                    {% if block.settings.image != blank %}
                        <img src="{{ block.settings.image | image_url: width: 800 }}" class="w-full rounded-lg" alt="Look">
                    {% else %}
                        {{ 'image' | placeholder_svg_tag: 'w-full rounded-lg bg-gray-200' }}
                    {% endif %}
                    <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white">
                        <span class="uppercase tracking-widest font-bold">Shop The Look</span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Summer Lookbook"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Lookbook Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook"
    }
  ]
}
{% endschema %}
