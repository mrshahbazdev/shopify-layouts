<section class="relative h-[600px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        {% if section.settings.video_url != blank %}
            <video class="w-full h-full object-cover" autoplay muted loop playsinline poster="{{ section.settings.cover_image | image_url: width: 1200 }}">
                <source src="{{ section.settings.video_url }}" type="video/mp4">
            </video>
        {% else %}
             <div class="w-full h-full bg-gray-900 flex items-center justify-center">
                <i class="fas fa-play-circle text-6xl text-gray-700"></i>
             </div>
        {% endif %}
        <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <div class="relative z-10 text-center text-white px-6 max-w-4xl">
        <h2 class="text-4xl md:text-6xl font-serif font-bold mb-6">{{ section.settings.heading }}</h2>
        <p class="text-lg md:text-xl text-gray-200 mb-8">{{ section.settings.subheading }}</p>
        {% if section.settings.link != blank %}
            <a href="{{ section.settings.link }}" class="bg-white text-black px-8 py-4 text-sm font-bold uppercase tracking-widest hover:bg-gray-200 transition inline-block">{{ section.settings.btn_text }}</a>
        {% endif %}
    </div>
</section>

{% schema %}
{
  "name": "Video Background",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Immersive Experience"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Watch our latest campaign video."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Direct link to .mp4 file"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover Image"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Video Background"
    }
  ]
}
{% endschema %}
