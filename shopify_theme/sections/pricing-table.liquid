<section class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-serif font-bold mb-4">{{ section.settings.title }}</h2>
      <p class="text-gray-500 max-w-xl mx-auto">{{ section.settings.text }}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {% for block in section.blocks %}
        <div class="border border-gray-100 rounded-2xl p-8 hover:shadow-xl transition relative overflow-hidden bg-white group">
          {% if block.settings.featured %}
            <div class="absolute top-0 right-0 bg-accent text-white text-xs font-bold px-3 py-1 rounded-bl-lg uppercase tracking-wider">Popular</div>
          {% endif %}

          <h3 class="text-lg font-bold uppercase tracking-widest text-gray-400 mb-4">{{ block.settings.title }}</h3>
          <div class="flex items-baseline mb-8">
            <span class="text-4xl font-bold text-primary">{{ block.settings.price }}</span>
            <span class="text-gray-400 ml-2">/ {{ block.settings.unit }}</span>
          </div>

          <ul class="space-y-4 mb-8 text-gray-600 text-sm">
             {{ block.settings.features }}
          </ul>

          <a href="{{ block.settings.link }}" class="block w-full text-center border-2 border-primary text-primary font-bold uppercase tracking-widest py-3 hover:bg-primary hover:text-white transition rounded-lg">
            {{ block.settings.btn_text }}
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pricing Table",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Membership Plans"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Join our exclusive club for free shipping and early access."
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured Plan",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Plan Name",
          "default": "Standard"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$0"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unit",
          "default": "month"
        },
        {
          "type": "liquid",
          "id": "features",
          "label": "Features List (HTML li)",
          "default": "<li><i class='fas fa-check text-green-500 mr-2'></i> Standard Shipping</li>\n<li><i class='fas fa-check text-green-500 mr-2'></i> Email Support</li>"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "Select Plan"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing Table",
      "blocks": [
        { "type": "plan" },
        { "type": "plan", "settings": { "featured": true, "title": "Gold", "price": "$19" } },
        { "type": "plan", "settings": { "title": "Platinum", "price": "$49" } }
      ]
    }
  ]
}
{% endschema %}
