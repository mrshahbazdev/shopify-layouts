<section class="py-20 overflow-hidden">
    <div class="container mx-auto px-6 mb-8 flex justify-between items-end">
        <h2 class="text-3xl font-serif font-bold">{{ section.settings.title }}</h2>
        <div class="flex gap-2">
            <button class="w-10 h-10 border border-gray-300 rounded-full flex items-center justify-center hover:bg-primary hover:text-white transition"><i class="fas fa-arrow-left"></i></button>
            <button class="w-10 h-10 border border-gray-300 rounded-full flex items-center justify-center hover:bg-primary hover:text-white transition"><i class="fas fa-arrow-right"></i></button>
        </div>
    </div>
    <div class="flex gap-6 overflow-x-auto hide-scrollbar px-6 md:px-[calc((100vw-1200px)/2)] pb-10">
        {% assign collection = collections[section.settings.collection] %}
        {% for product in collection.products limit: 8 %}
            <div class="min-w-[280px] w-[280px]">
                <img src="{{ product.featured_image | image_url: width: 600 }}" class="w-full h-[350px] object-cover mb-4 rounded-lg" alt="{{ product.title }}">
                <h3 class="font-bold">{{ product.title }}</h3>
                <p class="text-gray-500">{{ product.price | money }}</p>
            </div>
        {% else %}
            {% for i in (1..5) %}
                <div class="min-w-[280px] w-[280px]">
                    {{ 'product-1' | placeholder_svg_tag: 'w-full h-[350px] object-cover mb-4 rounded-lg text-gray-300' }}
                    <h3 class="font-bold">Product Title</h3>
                    <p class="text-gray-500">$99.00</p>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
</section>

{% schema %}
{
  "name": "Best Sellers Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Slider"
    }
  ]
}
{% endschema %}
