<section class="py-12 border-b border-gray-100">
    <div class="container mx-auto px-6">
        <p class="text-center text-xs text-gray-400 uppercase tracking-widest mb-8">{{ section.settings.heading }}</p>
        <div class="flex flex-wrap justify-center items-center gap-12 md:gap-20 opacity-50 grayscale hover:grayscale-0 transition-all duration-500">
            {% for block in section.blocks %}
              <i class="{{ block.settings.icon_class }} text-3xl"></i>
            {% else %}
                <i class="fab fa-vogue text-3xl"></i>
                <i class="fab fa-google text-3xl"></i>
                <i class="fab fa-spotify text-3xl"></i>
                <i class="fab fa-apple text-3xl"></i>
                <i class="fab fa-amazon text-3xl"></i>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Logo Cloud",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured In"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "text",
          "id": "icon_class",
          "label": "FontAwesome Class",
          "default": "fab fa-google"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Cloud"
    }
  ]
}
{% endschema %}
