<section class="relative h-[500px] md:h-[700px] group overflow-hidden">
    <div class="h-full flex transition-transform duration-700 ease-out" id="slideshow-track-{{ section.id }}" style="width: {{ section.blocks.size }}00%;">
        {% for block in section.blocks %}
            <div class="h-full relative flex items-center justify-center bg-gray-200" style="width: 100%;">
                {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 2000 }}" class="absolute inset-0 w-full h-full object-cover" alt="{{ block.settings.heading }}">
                {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover text-gray-400' }}
                {% endif %}
                <div class="absolute inset-0 bg-black/30"></div>
                <div class="relative z-10 text-center text-white px-6">
                    <h2 class="text-4xl md:text-6xl font-serif font-bold mb-4">{{ block.settings.heading }}</h2>
                    <p class="text-lg mb-8">{{ block.settings.subheading }}</p>
                    <a href="{{ block.settings.link }}" class="bg-white text-black px-8 py-3 font-bold uppercase tracking-widest hover:bg-gray-200 transition">{{ block.settings.btn_text }}</a>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Controls -->
    {% if section.blocks.size > 1 %}
        <button onclick="prevSlide('{{ section.id }}', {{ section.blocks.size }})" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/20 hover:bg-white text-white hover:text-black w-12 h-12 flex items-center justify-center rounded-full backdrop-blur-sm transition">
            <i class="fas fa-chevron-left"></i>
        </button>
        <button onclick="nextSlide('{{ section.id }}', {{ section.blocks.size }})" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/20 hover:bg-white text-white hover:text-black w-12 h-12 flex items-center justify-center rounded-full backdrop-blur-sm transition">
            <i class="fas fa-chevron-right"></i>
        </button>
    {% endif %}

    <script>
        // Simple vanilla JS slider logic for this section
        (function() {
            let currentIndex = 0;
            window.prevSlide = function(id, total) {
                currentIndex = (currentIndex > 0) ? currentIndex - 1 : total - 1;
                updateSlide(id);
            }
            window.nextSlide = function(id, total) {
                currentIndex = (currentIndex < total - 1) ? currentIndex + 1 : 0;
                updateSlide(id);
            }
            function updateSlide(id) {
                const track = document.getElementById(`slideshow-track-${id}`);
                if(track) track.style.transform = `translateX(-${currentIndex * (100 / {{ section.blocks.size }})}%)`;
            }
        })();
    </script>
</section>

{% schema %}
{
  "name": "Slideshow",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "New Season"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Shop the latest trends."
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
