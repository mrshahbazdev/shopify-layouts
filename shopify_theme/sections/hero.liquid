<section class="relative h-[80vh] flex items-center justify-center bg-gray-100 overflow-hidden">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.heading }}" class="absolute inset-0 w-full h-full object-cover">
    {% else %}
      <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" alt="Hero" class="absolute inset-0 w-full h-full object-cover">
    {% endif %}

    <div class="absolute inset-0 bg-black/20"></div>
    <div class="relative z-10 text-center text-white px-6">
        <h2 class="text-sm md:text-base font-medium tracking-[0.2em] mb-4 uppercase">{{ section.settings.subheading }}</h2>
        <h1 class="text-5xl md:text-7xl font-serif font-bold mb-8 leading-tight">{{ section.settings.heading | newline_to_br }}</h1>
        <div class="flex flex-col md:flex-row gap-4 justify-center">
            <a href="{{ section.settings.btn1_link }}" class="bg-white text-black px-8 py-4 text-sm font-bold uppercase tracking-widest hover:bg-gray-200 transition">{{ section.settings.btn1_text }}</a>
            <a href="{{ section.settings.btn2_link }}" class="border border-white text-white px-8 py-4 text-sm font-bold uppercase tracking-widest hover:bg-white hover:text-black transition">{{ section.settings.btn2_text }}</a>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "New Collection 2024"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your \nEveryday Style"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "Shop Women"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "Shop Men"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
