<section class="relative h-[80vh] flex items-center justify-center bg-gray-100 overflow-hidden group">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.heading }}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[20s] group-hover:scale-105">
    {% else %}
      <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" alt="Hero" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[20s] group-hover:scale-105">
    {% endif %}

    <div class="absolute inset-0 bg-black/30"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-4xl mx-auto">
        <h2 class="text-sm md:text-base font-medium tracking-[0.3em] mb-6 uppercase opacity-0 animate-fade-in-up" style="animation-delay: 0.2s; animation-fill-mode: forwards;">{{ section.settings.subheading }}</h2>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif font-bold mb-10 leading-tight opacity-0 animate-fade-in-up" style="animation-delay: 0.4s; animation-fill-mode: forwards;">{{ section.settings.heading | newline_to_br }}</h1>
        <div class="flex flex-col md:flex-row gap-6 justify-center opacity-0 animate-fade-in-up" style="animation-delay: 0.6s; animation-fill-mode: forwards;">
            {% if section.settings.btn1_text != blank %}
                <a href="{{ section.settings.btn1_link }}" class="bg-white text-black px-10 py-5 text-sm font-bold uppercase tracking-widest hover:bg-primary hover:text-white transition duration-300 shadow-lg">{{ section.settings.btn1_text }}</a>
            {% endif %}
            {% if section.settings.btn2_text != blank %}
                <a href="{{ section.settings.btn2_link }}" class="border border-white text-white px-10 py-5 text-sm font-bold uppercase tracking-widest hover:bg-white hover:text-black transition duration-300 shadow-lg">{{ section.settings.btn2_text }}</a>
            {% endif %}
        </div>
    </div>

    <style>
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in-up {
        animation-name: fadeInUp;
        animation-duration: 0.8s;
        animation-timing-function: ease-out;
      }
    </style>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "New Collection 2024"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your \nEveryday Style"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "Shop Women"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "Shop Men"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
