<section class="py-20 bg-gray-50">
  <div class="container mx-auto px-6 max-w-2xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-serif font-bold mb-4">{{ section.settings.title }}</h2>
      <p class="text-gray-500">{{ section.settings.text }}</p>
    </div>

    <div class="bg-white p-8 md:p-12 shadow-sm rounded-xl">
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div class="bg-green-100 text-green-700 p-4 rounded mb-6 text-center">
            Thanks for contacting us! We'll get back to you shortly.
          </div>
        {% endif %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label for="ContactFormName" class="block text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">Name</label>
            <input type="text" id="ContactFormName" name="contact[name]" class="w-full bg-gray-50 border border-gray-200 px-4 py-3 rounded outline-none focus:border-black transition" placeholder="Your Name" required>
          </div>
          <div>
            <label for="ContactFormEmail" class="block text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">Email</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" class="w-full bg-gray-50 border border-gray-200 px-4 py-3 rounded outline-none focus:border-black transition" placeholder="your@email.com" required>
          </div>
        </div>
        <div class="mb-6">
          <label for="ContactFormMessage" class="block text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">Message</label>
          <textarea rows="4" id="ContactFormMessage" name="contact[body]" class="w-full bg-gray-50 border border-gray-200 px-4 py-3 rounded outline-none focus:border-black transition" placeholder="How can we help?" required></textarea>
        </div>
        <button type="submit" class="w-full bg-primary text-white font-bold uppercase tracking-widest py-4 hover:bg-accent transition">Send Message</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Have a question? We're here to help."
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
