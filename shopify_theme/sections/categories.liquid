<section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
        <h2 class="text-3xl font-serif font-bold mb-12 text-center">{{ section.settings.title }}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
            {% for block in section.blocks %}
                <a href="{{ block.settings.url }}" class="group text-center">
                    <div class="w-full aspect-square rounded-full overflow-hidden mb-4 border-2 border-transparent group-hover:border-primary transition">
                        {% if block.settings.image != blank %}
                             <img src="{{ block.settings.image | image_url: width: 400 }}" class="w-full h-full object-cover group-hover:scale-110 transition duration-500" alt="{{ block.settings.title }}">
                        {% else %}
                             {{ 'collection-1' | placeholder_svg_tag: 'w-full h-full object-cover group-hover:scale-110 transition duration-500 text-gray-300' }}
                        {% endif %}
                    </div>
                    <h3 class="font-medium">{{ block.settings.title }}</h3>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Categories Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Category"
        },
        {
            "type": "url",
            "id": "url",
            "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories Grid"
    }
  ]
}
{% endschema %}
