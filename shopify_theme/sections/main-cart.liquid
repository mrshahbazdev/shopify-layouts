<section class="container mx-auto px-6 py-20 max-w-5xl">
  <h1 class="text-3xl font-serif font-bold mb-8">{{ 'cart.general.title' | t | default: 'Shopping Cart' }}</h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="border-t border-gray-200">
        {% for item in cart.items %}
          <div class="py-6 flex flex-col md:flex-row gap-6 items-center border-b border-gray-200">
            <div class="w-full md:w-32 h-32 flex-shrink-0">
               {% if item.image %}
                <img src="{{ item.image | image_url: width: 300 }}" class="w-full h-full object-cover rounded" alt="{{ item.title }}">
              {% endif %}
            </div>

            <div class="flex-grow text-center md:text-left">
              <h2 class="font-bold text-lg"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
              <p class="text-sm text-gray-500 mb-2">{{ item.variant.title }}</p>
              <div class="font-bold">{{ item.price | money }}</div>
            </div>

            <div class="flex items-center gap-4">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="w-16 border border-gray-300 rounded p-2 text-center">
              <a href="{{ item.url_to_remove }}" class="text-red-500 hover:text-red-700 text-sm font-bold uppercase tracking-widest">Remove</a>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="mt-8 flex flex-col md:flex-row justify-between items-center gap-6">
        <a href="{{ routes.all_products_collection_url }}" class="text-gray-600 hover:text-primary font-bold text-sm uppercase tracking-widest">Continue Shopping</a>

        <div class="text-right space-y-4">
          <div class="text-xl font-bold">Subtotal: {{ cart.total_price | money }}</div>
          <p class="text-sm text-gray-500">Taxes and shipping calculated at checkout</p>
          <button type="submit" name="checkout" class="bg-primary text-white px-10 py-4 font-bold uppercase tracking-widest hover:bg-accent transition w-full md:w-auto">Checkout</button>
        </div>
      </div>
    </form>
  {% else %}
    <div class="text-center py-20 bg-gray-50 rounded-lg">
      <p class="text-xl text-gray-500 mb-6">Your cart is empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="bg-primary text-white px-8 py-3 font-bold uppercase tracking-widest hover:bg-accent transition">Start Shopping</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
