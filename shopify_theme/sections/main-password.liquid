<section class="h-screen flex items-center justify-center bg-gray-100">
  <div class="bg-white p-12 rounded-xl shadow-lg max-w-md w-full text-center">
    <h1 class="text-3xl font-serif font-bold mb-6">Opening Soon</h1>
    <p class="text-gray-500 mb-8">Enter your password to access the store.</p>

    {% form 'storefront_password' %}
      {% if form.errors %}
        <div class="text-red-500 text-sm mb-4">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="mb-4">
        <input type="password" name="password" placeholder="Password" class="w-full border border-gray-300 rounded px-4 py-3 outline-none focus:border-black transition">
      </div>
      <button type="submit" class="w-full bg-primary text-white py-3 font-bold uppercase tracking-widest hover:bg-accent transition">Enter</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password Page",
  "settings": []
}
{% endschema %}
