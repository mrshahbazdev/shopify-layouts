<section class="h-[400px] md:h-[500px] relative w-full bg-gray-200">
  <!-- Interactive Map Placeholder / Iframe -->
  <div class="absolute inset-0 grayscale contrast-125">
    {% if section.settings.iframe_html != blank %}
        {{ section.settings.iframe_html }}
    {% else %}
        <iframe width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" src="https://maps.google.com/maps?width=100%25&amp;height=600&amp;hl=en&amp;q=1%20Grafton%20Street,%20Dublin,%20Ireland+(My%20Business%20Name)&amp;t=&amp;z=14&amp;ie=UTF8&amp;iwloc=B&amp;output=embed"></iframe>
    {% endif %}
  </div>

  <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 md:left-20 md:translate-x-0 bg-white p-10 shadow-xl max-w-sm w-full mx-4">
    <h3 class="font-serif font-bold text-2xl mb-6">{{ section.settings.title }}</h3>
    <div class="space-y-4 text-gray-600 text-sm">
      <p class="flex items-start gap-3">
        <i class="fas fa-map-marker-alt mt-1 text-primary"></i>
        <span>{{ section.settings.address | newline_to_br }}</span>
      </p>
      <p class="flex items-start gap-3">
        <i class="far fa-clock mt-1 text-primary"></i>
        <span>{{ section.settings.hours | newline_to_br }}</span>
      </p>
      <a href="{{ section.settings.directions_link }}" class="inline-block mt-4 text-primary font-bold uppercase tracking-widest text-xs border-b border-primary pb-1 hover:text-accent hover:border-accent transition">Get Directions</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Map / Store Locator",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Card Title",
      "default": "Visit Our Flagship"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "123 Fashion Ave,\nNew York, NY 10001"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Hours",
      "default": "Mon - Fri: 10am - 8pm\nSat - Sun: 11am - 6pm"
    },
    {
      "type": "html",
      "id": "iframe_html",
      "label": "Google Maps Embed HTML"
    },
    {
      "type": "url",
      "id": "directions_link",
      "label": "Directions Link"
    }
  ],
  "presets": [
    {
      "name": "Map"
    }
  ]
}
{% endschema %}
