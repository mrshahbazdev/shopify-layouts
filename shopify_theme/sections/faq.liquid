<section class="py-20">
    <div class="container mx-auto px-6 max-w-3xl">
        <h2 class="text-3xl font-serif font-bold text-center mb-12">{{ section.settings.title }}</h2>
        <div class="space-y-4">
            {% for block in section.blocks %}
                <details class="group border border-gray-200 rounded-lg bg-white overflow-hidden">
                    <summary class="flex justify-between items-center p-6 cursor-pointer font-bold list-none group-open:bg-gray-50 transition">
                        <span>{{ block.settings.question }}</span>
                        <i class="fas fa-plus group-open:hidden text-gray-400"></i>
                        <i class="fas fa-minus hidden group-open:block text-gray-400"></i>
                    </summary>
                    <div class="p-6 pt-0 text-gray-600 leading-relaxed group-open:bg-gray-50">
                        {{ block.settings.answer }}
                    </div>
                </details>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does shipping take?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Standard shipping takes 5-7 business days."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
