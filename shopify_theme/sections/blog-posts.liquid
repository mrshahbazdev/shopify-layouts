<section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
        <h2 class="text-3xl font-serif font-bold mb-12 text-center">{{ section.settings.title }}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {% assign blog = blogs[section.settings.blog] %}
            {% for article in blog.articles limit: 3 %}
                <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition">
                    <img src="{{ article.image | image_url: width: 800 }}" class="w-full h-48 object-cover" alt="{{ article.title }}">
                    <div class="p-6">
                        <span class="text-xs text-accent font-bold uppercase">{{ article.tags.first }}</span>
                        <h3 class="font-bold text-xl mt-2 mb-3">{{ article.title }}</h3>
                        <p class="text-gray-500 text-sm mb-4">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
                        <a href="{{ article.url }}" class="text-sm font-bold underline decoration-accent decoration-2 underline-offset-4">Read More</a>
                    </div>
                </article>
            {% else %}
                {% for i in (1..3) %}
                    <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition">
                         {{ 'image' | placeholder_svg_tag: 'w-full h-48 object-cover bg-gray-200' }}
                        <div class="p-6">
                            <span class="text-xs text-accent font-bold uppercase">Fashion</span>
                            <h3 class="font-bold text-xl mt-2 mb-3">Blog Post Title</h3>
                            <p class="text-gray-500 text-sm mb-4">Discover the key pieces you need to update your wardrobe this coming season...</p>
                            <a href="#" class="text-sm font-bold underline decoration-accent decoration-2 underline-offset-4">Read More</a>
                        </div>
                    </article>
                {% endfor %}
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Blog Posts",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "From The Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "Blog Posts"
    }
  ]
}
{% endschema %}
