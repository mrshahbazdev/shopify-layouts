<section class="py-20 bg-primary text-white text-center">
    <div class="container mx-auto px-6">
        <span class="text-accent uppercase tracking-widest font-bold text-sm">{{ section.settings.eyebrow }}</span>
        <h2 class="text-4xl md:text-5xl font-serif font-bold mt-4 mb-8">{{ section.settings.title }}</h2>
        <div class="flex justify-center gap-8 mb-10">
            <div class="text-center"><div class="text-4xl font-bold font-mono">08</div><div class="text-xs uppercase text-gray-400 mt-1">Hours</div></div>
            <div class="text-center"><div class="text-4xl font-bold font-mono">45</div><div class="text-xs uppercase text-gray-400 mt-1">Minutes</div></div>
            <div class="text-center"><div class="text-4xl font-bold font-mono">12</div><div class="text-xs uppercase text-gray-400 mt-1">Seconds</div></div>
        </div>
        <p class="mb-8 text-gray-300">{{ section.settings.description }}</p>
        <a href="{{ section.settings.link }}" class="inline-block bg-white text-primary px-10 py-4 font-bold uppercase tracking-widest hover:bg-accent hover:text-white transition">{{ section.settings.btn_text }}</a>
    </div>
</section>

{% schema %}
{
  "name": "Deal of the Day",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Don't Miss Out"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Deal of the Day"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get 50% off the Summer Collection. Offer ends soon."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Shop The Deal"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Deal of the Day"
    }
  ]
}
{% endschema %}
